#!/usr/bin/env ruby

require_relative "../lib/podcast_buddy"
require "optparse"
require "rainbow"
require "timeout"
require "fileutils"

options = {}
OptionParser.new do |opts|
  opts.banner = "Usage: podcast_buddy [options]"

  opts.on("--debug", "Run in debug mode") do |v|
    options[:debug] = v
  end

  opts.on("-w", "--whisper MODEL", "Use specific whisper model (default: small.en)") do |v|
    options[:whisper_model] = v
  end

  opts.on("-n", "--name NAME", "A name for the session to label all log files") do |v|
    options[:name] = v
  end

  opts.on("-d", "--description DESCRIPTION", "A description of the show, meeting, or general discussion") do |v|
    options[:description] = v
  end
end.parse!

def to_human(text, label = :info)
  case label.to_sym
  when :info
    Rainbow(text).blue
  when :wait
    Rainbow(text).yellow
  when :input
    Rainbow(text).black.bg(:yellow)
  when :success
    Rainbow(text).green
  else
    text
  end
end

PodcastBuddy.logger.formatter = proc do |severity, datetime, progname, msg|
  if severity.to_s == "INFO"
    "#{msg}\n"
  else
    "[#{severity}] #{msg}\n"
  end
end

if options[:debug]
  PodcastBuddy.logger.info to_human("Turning on debug mode...", :info)
  PodcastBuddy.logger.level = Logger::DEBUG
else
  PodcastBuddy.logger.level = Logger::INFO
end

if options[:whisper_model]
  PodcastBuddy.config.whisper_model = options[:whisper_model]
  PodcastBuddy.logger.info to_human("Using whisper model: #{options[:whisper_model]}", :info)
end

if options[:name]
  base_path = "#{PodcastBuddy.root}/tmp/#{options[:name]}"
  FileUtils.mkdir_p base_path
  PodcastBuddy.session = options[:name]
  PodcastBuddy.logger.info to_human("Using custom session name: #{options[:name]}", :info)
  PodcastBuddy.logger.info to_human("  Saving files to: #{PodcastBuddy.session.base_path}", :info)
end

if options[:description]
  PodcastBuddy.config.show_description = options[:description]
end

PodcastBuddy.logger.info "Setting up dependencies..."
PodcastBuddy.setup
PodcastBuddy.logger.info "Setup complete."

# OpenAI API client setup
# Raises error if no OPENAI_ACCESS_TOKEN env is set
PodcastBuddy.openai_client

# Initialize variables
@transcriber = PodcastBuddy::Transcriber.new
@shutdown = false

ObserverPrompt = PodcastBuddy::Prompt.new(
  system_content: <<~PROMPT.freeze,
    Listen to a transcript of participants having a discussion and make insightful observations that can be used to participate in the discussion upon request.

    ### Key Details:
    - Focus on identifying key themes, arguments, and perspectives within the discussion.
    - Take note of any points of consensus or disagreement among participants.
    - Consider the context and nuances in participants' statements to form well-rounded observations.

    # Steps

    1. **Listen and Analyze:**
      - Carefully go through the transcript to understand the main points and arguments presented.
      - Pay attention to the tone and intention of each speaker.

    2. **Identify Key Themes:**
      - Determine the central topics and themes discussed by the participants.
      - Categorize these themes into overarching discussion points.

    3. **Recognize Perspectives:**
      - Capture the different perspectives and arguments made by participants.
      - Document both supporting and opposing views for completeness.

    4. **Evaluate Consensus and Disagreements:**
      - Note areas where participants agree and where there is contention.
      - Highlight particularly compelling arguments or unanswered questions.

    5. **Synthesize Observations:**
      - Formulate coherent observations based on the analyzed information.
      - Ensure observations are relevant and add value to the ongoing discussion.

    # Output Format

    - Provide a structured list or brief paragraphs highlighting key observations, themes, points of consensus, and disagreements.
    - Each observation should be concise yet informative, ideally formatted in bullet points or sections.

    # Examples

    **Transcript Excerpt:**
    I believe the new policy will lead to increased productivity due to its structured approach.
    However, the policy might limit creativity, which is critical for innovation.

    **Observation for Participation:**
    - **Theme:** Policy Impact on Productivity
      - Observation: "There's an ongoing debate about the new policy's effect, highlighting the balance between structure and creativity. Speaker 1 notes increased productivity, while Speaker 2 raises concerns about potential impacts on creativity."

    # Notes

    - Remain neutral and objective in observations to ensure balance in participation.
    - Consider the dynamics of the discussion to tailor observations appropriately.
  PROMPT
  user_template: <<~TEMPLATE.freeze
    Transcript Excerpt:
    """
    %{transcript}
    """
  TEMPLATE
)

